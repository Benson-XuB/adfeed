# AdFeed AI — FastAPI backend (phase0/.env)
# Copy to phase0/.env on the server. Never commit real secrets.

# ── LLM (required for feed generation) ──
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ── Shopify OAuth (Partner Dashboard → App → Client credentials) ──
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://deltfu.com/api/shopify/callback

# ── Public URLs ──
ADFEED_PUBLIC_URL=https://deltfu.com

# Production billing (must be false for real charges)
ADFEED_BILLING_TEST=false

# Optional: Stripe / R2 image CDN
# STRIPE_SECRET_KEY=
# R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=adfeed-images
# R2_PUBLIC_URL=

# Optional: image AI cleanup per job
# IMAGE_AI_ENABLED=false
# IMAGE_CLEAN_MAX_PER_JOB=20

# ── Public marketing tools: Google OAuth (separate redirect from App) ──
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_PUBLIC_OAUTH_REDIRECT_URI=https://deltfu.com/api/public/google/oauth/callback
# Local landing+API proxy example:
# GOOGLE_PUBLIC_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/api/public/google/oauth/callback
# ADFEED_PUBLIC_URL=http://127.0.0.1:8765
#
# ── Marketing Google Ads monitor (Ads API; does NOT touch Shopify App) ──
# Add this redirect in Cloud Console on the same or a dedicated Web client:
# GOOGLE_ADS_OAUTH_REDIRECT_URI=https://deltfu.com/api/public/google-ads/oauth/callback
# GOOGLE_ADS_DEVELOPER_TOKEN=          # apply in Google Ads API Center; required for live data
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=       # optional MCC id (digits only)
# GOOGLE_ADS_API_VERSION=v19
#
# ── App MC Push OAuth (MUST be a different redirect URI in Cloud Console) ──
# GOOGLE_APP_OAUTH_REDIRECT_URI=https://deltfu.com/api/app/google/oauth/callback
# GOOGLE_APP_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/app/google/oauth/callback
# App Admin URL slug (Partner / listing handle). Required for Shopify App Pricing redirects:
# https://admin.shopify.com/store/{shop}/charges/{SHOPIFY_APP_HANDLE}/pricing_plans
# SHOPIFY_APP_HANDLE=adfeed-ai
