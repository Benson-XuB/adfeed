# AdFeed AI — FastAPI backend (phase0/.env)
# Copy to phase0/.env on the server. Never commit real secrets.

# ── LLM (required for feed generation) ──
DASHSCOPE_API_KEY=sk-your-dashscope-key

# ── Shopify OAuth (Partner Dashboard → App → Client credentials) ──
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://deltfu.com/api/shopify/callback

# ── Public URLs ──
ADFEED_PUBLIC_URL=https://deltfu.com

# Production billing (must be false for real charges)
ADFEED_BILLING_TEST=false

# Optional: Stripe / R2 image CDN
# STRIPE_SECRET_KEY=
# R2_ENABLED=false
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=adfeed-images
# R2_PUBLIC_URL=

# Optional: image AI cleanup per job
# IMAGE_AI_ENABLED=false
# IMAGE_CLEAN_MAX_PER_JOB=20
