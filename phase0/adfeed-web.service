[Unit]
Description=AdFeed AI — React Router (Shopify embedded app)
After=network.target

[Service]
Type=simple
User=adfeed
Group=adfeed
WorkingDirectory=/opt/adfeed/phase0/add-feed-ai/web
EnvironmentFile=/opt/adfeed/phase0/add-feed-ai/web/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/npm run start
Restart=always
RestartSec=3
StandardOutput=append:/var/log/adfeed-web.log
StandardError=append:/var/log/adfeed-web.log

[Install]
WantedBy=multi-user.target
