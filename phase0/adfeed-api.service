[Unit]
Description=AdFeed AI — FastAPI Backend
After=network.target

[Service]
Type=simple
User=adfeed
Group=adfeed
WorkingDirectory=/opt/adfeed/phase0
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/adfeed/.venv/bin/python3 server.py --port 8000
Restart=always
RestartSec=3
TimeoutStopSec=300
StandardOutput=append:/var/log/adfeed-api.log
StandardError=append:/var/log/adfeed-api.log

[Install]
WantedBy=multi-user.target
