# Production URL backup for Partner / release deploy.
# iframe App Home: application_url + /auth/callback = hosted React Router (`add-feed-ai/web`).
# FastAPI webhooks stay on the same host under /api/webhooks/...
# Local trycloudflare lives in shopify.app.toml — do not submit that for review.

client_id = "ac2bf432a87c7e12cb7c439556fe762b"
name = "AdFeed AI"
application_url = "https://deltfu.com"
embedded = true

[build]
automatically_update_urls_on_dev = true

[webhooks]
api_version = "2026-07"

  [[webhooks.subscriptions]]
  compliance_topics = [ "customers/data_request", "customers/redact", "shop/redact" ]
  uri = "https://deltfu.com/api/webhooks/shopify/compliance"

  [[webhooks.subscriptions]]
  topics = [ "app/uninstalled" ]
  uri = "https://deltfu.com/api/webhooks/shopify/app_uninstalled"

  [[webhooks.subscriptions]]
  topics = [ "products/update" ]
  uri = "https://deltfu.com/api/webhooks/shopify/products_update"

  [[webhooks.subscriptions]]
  topics = [ "products/delete" ]
  uri = "https://deltfu.com/api/webhooks/shopify/products_delete"

  [[webhooks.subscriptions]]
  topics = [ "app_subscriptions/update" ]
  uri = "https://deltfu.com/api/webhooks/shopify/app_subscriptions_update"

[access.admin]
direct_api_mode = "online"
embedded_app_direct_api_access = true

[access_scopes]
scopes = "read_products"

[auth]
redirect_urls = [
  "https://deltfu.com/auth/callback",
  "https://deltfu.com/api/shopify/callback",
]

[sidekick]
extensions_summary = "Generate Google Shopping feeds from the Shopify catalog"
