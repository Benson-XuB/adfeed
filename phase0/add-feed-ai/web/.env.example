# AdFeed AI — React Router / Shopify session app (add-feed-ai/web/.env)
# Copy to add-feed-ai/web/.env on the server.

SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SCOPES=read_products,write_products,read_legal_policies
SHOPIFY_APP_URL=https://deltfu.com

# Same origin — nginx proxies /api to FastAPI :8000
BACKEND_URL=https://deltfu.com
VITE_BACKEND_URL=https://deltfu.com

PORT=3000
NODE_ENV=production
